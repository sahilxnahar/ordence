    "e2e:mobile": "node scripts/e2e-mobile-nav.mjs",
    "e2e:tenant": "node scripts/e2e-tenant-lifecycle.mjs",
    "e2e:provisioning": "node scripts/e2e-provisioning.mjs",
    "e2e:renewal": "node scripts/e2e-renewal.mjs",
    "measure": "node scripts/measure-page.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "framer-motion": "^12.43.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
